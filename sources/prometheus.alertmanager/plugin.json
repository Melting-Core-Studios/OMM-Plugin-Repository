{
  "schema": "open-map-monitor.runtime/v1",
  "id": "prometheus.alertmanager",
  "version": "1.0.0",
  "apiVersion": "open-map-monitor.plugin/v1",
  "entrypoint": "src/index.mjs",
  "permissions": {
    "networkHosts": [],
    "secrets": [
      "receiverSecret"
    ],
    "localCollectorRequired": false
  },
  "hooks": [
    "initialize",
    "configChanged",
    "enable",
    "disable",
    "stop",
    "health",
    "discover",
    "webhook"
  ]
}
