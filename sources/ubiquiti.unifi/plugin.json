{
  "schema": "open-map-monitor.runtime/v1",
  "id": "ubiquiti.unifi",
  "version": "1.0.0",
  "apiVersion": "open-map-monitor.plugin/v1",
  "entrypoint": "src/index.mjs",
  "permissions": {
    "networkHosts": [
      "api.ui.com"
    ],
    "secrets": [
      "apiKey"
    ],
    "localCollectorRequired": false
  },
  "hooks": [
    "initialize",
    "configChanged",
    "enable",
    "disable",
    "stop",
    "health",
    "discover",
    "poll",
    "webhook"
  ],
  "pollIntervalMs": 300000
}
