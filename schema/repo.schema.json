{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/open-map-monitor-repository-v1.json",
  "title": "Open Map Monitor signed plugin repository v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generatedAt",
    "keyId",
    "plugins",
    "signature"
  ],
  "properties": {
    "schema": {
      "const": "open-map-monitor.repository/v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "keyId": {
      "type": "string",
      "minLength": 1
    },
    "signature": {
      "type": "string",
      "minLength": 40
    },
    "plugins": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": [
          "id",
          "latest",
          "versions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]+$"
          },
          "latest": {
            "type": "string"
          },
          "versions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "version",
                "channel",
                "manifest",
                "permissions",
                "api",
                "package",
                "publisher",
                "capabilities"
              ],
              "properties": {
                "version": {
                  "type": "string"
                },
                "channel": {
                  "enum": [
                    "stable",
                    "beta"
                  ]
                },
                "manifest": {
                  "type": "object"
                },
                "permissions": {
                  "type": "object"
                },
                "api": {
                  "type": "object"
                },
                "package": {
                  "type": "object",
                  "required": [
                    "url",
                    "sha256",
                    "bytes",
                    "keyId",
                    "signature"
                  ],
                  "properties": {
                    "url": {
                      "type": "string"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "bytes": {
                      "type": "integer",
                      "minimum": 100
                    },
                    "keyId": {
                      "type": "string"
                    },
                    "signature": {
                      "type": "string"
                    }
                  }
                },
                "publisher": {
                  "type": "string"
                },
                "capabilities": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "category": {
            "enum": [
              "network",
              "monitoring",
              "devices",
              "utilities",
              "other"
            ]
          }
        }
      }
    }
  }
}
